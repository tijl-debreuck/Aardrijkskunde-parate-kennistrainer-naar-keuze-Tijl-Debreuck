# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD / ADMIN_PASSWORD_HASH:
# Secret administrator password or its SHA-256 hash.
# Configure this in environment variables or host secret manager (never commit plaintext passwords to Git!).
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# DATABASE_URL: PostgreSQL connection string (verplicht).
# Krijg je van je databasehost (Neon, Supabase, Render, Railway, ...).
# De tabellen worden automatisch aangemaakt bij de eerste start.
DATABASE_URL="postgres://gebruiker:wachtwoord@host:5432/geotrainer?sslmode=require"
